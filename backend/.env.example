# Django Core Settings
SECRET_KEY=your_secret_key
DEBUG=True

# Hostnames allowed to serve the Django backend in production.
# In development (DEBUG=True), localhost and 127.0.0.1 are appended automatically.
ALLOWED_HOSTS=gridy-backend.onrender.com

# Trusted origins for CSRF protection. In development (DEBUG=True),
# localhost ports (5173, 3000) are trusted automatically.
CSRF_TRUSTED_ORIGINS=https://gridy.vercel.app,https://gridy-backend.onrender.com

# Exact browser frontend origins allowed to access the API.
# In the intended production topology, the Vercel/Nginx reverse proxy handles web traffic as same-origin.
# Set an origin here only if a specific direct-browser client requires CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# Refresh token cookie SameSite policy. Defaults to Strict for same-origin or reverse-proxy setups.
# Lax works only for compatible same-site setups (e.g. subdomains of the same registrable domain).
# Cross-site API requests (different domains without a reverse proxy) require SameSite=None and SECURE (HTTPS).
REFRESH_COOKIE_SAMESITE=Strict

# Private production-only list of exact test/demo usernames that must not log
# in. Set this in the production service environment, not in a committed file.
# Separate usernames with commas. Leave blank for local development.
BLOCKED_PRODUCTION_LOGIN_USERNAMES=

# Database Configuration
DATABASE_URL=

# Local tests use SQLite by default; set False to test PostgreSQL row locking.
# GRIDY_TEST_USE_SQLITE remains a fallback for existing developer/CI environments.
KAPITBAYAN_TEST_USE_SQLITE=True

# Cloudinary Configuration (required in production for persistent media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Configuration
# Production requires a valid Firebase service-account JSON file and absolute path.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# Production PostgreSQL Database Configurations (Optional fallback)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5433

SENTRY_DSN=

# Email SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Defaults to EMAIL_HOST_USER when blank. Production must configure SMTP credentials.
DEFAULT_FROM_EMAIL=
